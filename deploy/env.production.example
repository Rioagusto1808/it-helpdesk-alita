# .env production untuk https://ticketing.alita.id
# Disalin setup-server.sh ke /var/www/ticketing/shared/.env (APP_KEY dibuat otomatis).
# Jangan pernah commit file .env yang berisi password.

APP_NAME="IT Helpdesk Alita"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ticketing.alita.id
APP_TIMEZONE=Asia/Jakarta
# APP_ASSET_VERSION diisi otomatis oleh deploy.sh (hash commit).

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# IP WAF/reverse proxy (Sophos) yang meneruskan request ke server ini, pisahkan dengan koma.
# Pakai * hanya jika port web server ini tidak bisa diakses langsung selain lewat proxy.
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alita_helpdesk
DB_USERNAME=alita
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email: SMTP SSL port 465 (smtps). Password yang berisi # atau @ wajib diberi tanda kutip.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.alita-indonesia.com
MAIL_PORT=465
MAIL_USERNAME=aibas.notification@alita.id
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=aibas.notification@alita.id
MAIL_FROM_NAME="IT Helpdesk Alita"

HELPDESK_NAME="IT Helpdesk Alita"
HELPDESK_ADMIN_EMAIL=rio@alita.id
HELPDESK_ALLOWED_EMAIL_DOMAINS=
HELPDESK_MAX_UPLOAD_KB=5120
HELPDESK_TRACKING_LINK_DAYS=30
HELPDESK_AUTO_CLOSE_DAYS=3
