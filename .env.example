APP_NAME="IT Helpdesk Alita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_ASSET_VERSION=1

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alita_helpdesk
DB_USERNAME=alita
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true di production (HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Email. Untuk development pakai "log" (email ditulis ke storage/logs/laravel.log).
# Production contoh Microsoft 365: MAIL_MAILER=smtp, MAIL_HOST=smtp.office365.com, MAIL_PORT=587, MAIL_SCHEME=null
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@alita.id"
MAIL_FROM_NAME="${APP_NAME}"

# Helpdesk
HELPDESK_NAME="IT Helpdesk Alita"
HELPDESK_ADMIN_EMAIL=rio@alita.id          # boleh lebih dari satu: rio@alita.id,it@alita.id
HELPDESK_ALLOWED_EMAIL_DOMAINS=            # kosong = semua domain; contoh: alita.id
HELPDESK_MAX_UPLOAD_KB=5120
HELPDESK_TRACKING_LINK_DAYS=30
HELPDESK_AUTO_CLOSE_DAYS=3
